# Copy to .env and fill in. Never commit .env.
PORTWATCH_SECRET=replace-with-a-long-random-string    # python -c "import secrets;print(secrets.token_urlsafe(48))"
PORTWATCH_PUBLIC_URL=https://portwatch.example.com    # used in password-reset links
PORTWATCH_NMAP_SCAN_TYPE=connect                      # connect | syn
PORTWATCH_SIMULATE=0

# Uncomment for the postgres profile:
# POSTGRES_PASSWORD=replace-with-a-strong-password
# PORTWATCH_DB_URI=postgresql+psycopg://portwatch:replace-with-a-strong-password@db:5432/portwatch

# Optional SMTP (alerts + password reset email):
# PORTWATCH_SMTP_HOST=smtp.example.com
# PORTWATCH_SMTP_PORT=587
# PORTWATCH_SMTP_USER=alerts@example.com
# PORTWATCH_SMTP_PASSWORD=app-password
# PORTWATCH_SMTP_FROM=PortWatch <alerts@example.com>
