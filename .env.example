# Copy to .env and fill in. Never commit .env.
PORTWATCH_SECRET=replace-with-a-long-random-string    # python -c "import secrets;print(secrets.token_urlsafe(48))"
PORTWATCH_PUBLIC_URL=https://portwatch.example.com    # used in password-reset links
PORTWATCH_NMAP_SCAN_TYPE=connect                      # connect | syn
PORTWATCH_SIMULATE=0

# Uncomment for the postgres profile:
# POSTGRES_PASSWORD=replace-with-a-strong-password
# PORTWATCH_DB_URI=postgresql+psycopg://portwatch:replace-with-a-strong-password@db:5432/portwatch

# Optional SMTP (alerts + password reset email):
# PORTWATCH_SMTP_HOST=smtp.example.com
# PORTWATCH_SMTP_PORT=587
# PORTWATCH_SMTP_USER=alerts@example.com
# PORTWATCH_SMTP_PASSWORD=app-password
# PORTWATCH_SMTP_FROM=PortWatch <alerts@example.com>

# ── Safety controls (added in the hardening pass) ──
# Live credential spraying is OFF by default; every spray simulates unless this
# is set. Only enable it for an engagement with signed, in-scope authorization.
# LIVE_CREDENTIAL_TESTING=0
#
# Private/internal RFC1918 targets (10/8, 172.16/12, 192.168/16) are refused by
# default. Enable only for authorised internal engagements. Loopback and cloud
# metadata endpoints stay blocked regardless.
# ALLOW_PRIVATE_TARGETS=0
#
# Largest CIDR a range scan may cover (guards against accidental huge sweeps).
# MAX_CIDR_HOSTS=1024
#
# Maximum request body size in bytes (default 1 MiB).
# MAX_CONTENT_LENGTH=1048576
#
# Override the Content-Security-Policy if your deployment needs to.
# PORTWATCH_CSP=
